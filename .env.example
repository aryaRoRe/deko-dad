# Copy to .env on the server and set your own values.
DEKO_HOST=127.0.0.1
DEKO_PORT=8787
DEKO_PUBLIC_ORIGIN=http://127.0.0.1:8787
# Comma-separated exact origins allowed to display the widget on another site.
DEKO_EMBED_ORIGINS=
DEKO_DB_PATH=./data/deko.sqlite
DEKO_TEAM_PASSWORD=
OPENAI_API_KEY=
DEKO_OPENAI_MODEL=gpt-5-mini
# Only set these on the server or in the host's encrypted secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Needed only by the Cloudflare deployment command.
DEKO_D1_DATABASE_ID=
